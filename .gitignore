# --- AlphaLab .gitignore ---------------------------------------------------
# Documentation policy: all Markdown and all planning documents stay out of
# Git. Public documentation lives in README.rst; shared results are
# .json / .csv / .rst.

# All Markdown, including agent instructions and skills.
*.md
*.markdown
*.mdx

# Plans, PRDs, design notes and private working documents.
planning/
.planning/
plans/
docs/planning/
docs/plans/
*_PRD.*
*.prd
*.plan

# Local agent configuration and skills; regenerated by tools/bootstrap_commit_skill.py.
.agents/
.claude/

# Private local commit tooling; never tracked.
/tools/bootstrap_commit_skill.py
/tools/commit_policy.toml
/tools/commit_safe.py
/tools/commit_skill_template.txt

# Secrets
.env
.env.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.python-version

# Test / type / coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks
.ipynb_checkpoints/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
